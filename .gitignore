node_modules/
dist/
.venv/
.vercel/

# ── Telifli kaynak materyal — DEPOYA GİRMEZ ───────────────────────────────
# Referans alınan harita animasyonu @destanevreni'ye aittir. Oyunda yalnızca
# ondan örneklenen RENK DEĞERLERİ kullanılıyor (src/style/tokens.ts); videonun
# kendisi yeniden dağıtılamaz.
*.mp4
*.mov
*.webm

# ── Harita derleme önbelleği ──────────────────────────────────────────────
# Hepsi TÜRETİLMİŞ veri: fetch_terrain.py / fetch_world_terrain.py /
# geocode*.py yeniden üretir. Bir kez yanlışlıkla commit edildiler ve
# depoyu 230 MB'a çıkardılar (1.538 ham karo, dört yükseklik ızgarası);
# geçmiş temizlendi, depo 27 MB'a indi.
tools/data/tiles/
tools/world/data/tiles/
# Yükseklik ızgaraları: ~25 saniyede yeniden iniyor, üçü birden 44 MB.
tools/data/elev*.npz
tools/world/data/*.npz
tools/data/*.html
tools/data/*.txt
tools/data/*.pdf
tools/data/coastline.json
__pycache__/
*.pyc

# Natural Earth il katmanı 38,8 MB ve kamu malı; depoyu üç katına
# çıkarmasının anlamı yok. tools/world/fetch_natural_earth.py birebir
# aynı dosyayı indiriyor (bayt bayt doğrulandı).
tools/world/ne_10m_admin_1_states_provinces.geojson

# Üretilmiş harita çıktıları (src/data/map*.json, public/relief*.png) depoda
# TUTULUR: derleme zinciri yüzlerce MB indirme gerektiriyor, oysa çıktı
# birkaç yüz KB. Tarihsel sınır geojson'ları (world_1914/1938, 1,2-1,6 MB)
# da kalır — aourednik/historical-basemaps'ten elle türetilmiş girdi.

*.log
.DS_Store
.vercel
.env*
